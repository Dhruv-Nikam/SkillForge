{
  "name": "skillforge",
  "private": true,
  "version": "1.0.0",
  "description": "SkillForge — Premier peer-to-peer student skill exchange and collaborative learning platform.",
  "author": "Dhruv-Nikam",
  "homepage": "https://github.com/Dhruv-Nikam/SkillForge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhruv-Nikam/SkillForge.git"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "preview": "npm run preview --workspace client",
    "start": "npm start --workspace server",
    "test": "npm test --workspace server",
    "check": "npm run lint && npm run build && npm test"
  }
}
